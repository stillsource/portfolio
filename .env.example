KDRIVE_API_TOKEN=your_infomaniak_api_token_here
KDRIVE_DRIVE_ID=your_drive_id_here
KDRIVE_FOLDER_ID=root_folder_id_containing_roll_subfolders

# Public site origin — drives sitemap, canonical URLs and OG tags.
# REQUIRED in production (set it in the Vercel project env vars); the build
# fails fast if missing when VERCEL_ENV=production. Dev falls back to localhost.
SITE_URL=https://your-domain.example

---
// Roll.astro — radical "errance & invisible" layout.
// Each photo takes a full viewport. Poems are hidden by default; on desktop
// they fade in on hover (bottom-left overlay), on mobile a discreet eye icon
// reveals a slide-up sheet with the poem and EXIF.
import type { RollData } from '../types/content';
import { formatExif } from '../scripts/utils/formatExif';
import { neutralTextForPalette } from '../data/poemColor';

export interface Props {
  title: string;
  poem?: string;
  dominantColor?: string;
  palette?: string[];
  images: RollData['images'];
  // Kept in the public API for backwards compat with callers; the radical
  // layout reveals poems on action rather than via scroll-driven animations.
  poemAnimation?: 'scroll' | 'typewriter' | 'fade' | 'slide' | 'word' | 'blur' | 'random';
}
const { title, poem, dominantColor = '#050505', palette, images } = Astro.props;
const isProd = import.meta.env.PROD;
const vercelImg = (url: string, w: number) =>
  isProd ? `/_vercel/image?url=${encodeURIComponent(url)}&w=${w}&q=80` : url;

type ImageItem = RollData['images'][number];

const effectivePalette = palette && palette.length > 0
  ? palette
  : (images[0]?.palette && images[0].palette.length > 0 ? images[0].palette : [dominantColor]);

const heroPoem = neutralTextForPalette(effectivePalette[0]);

const imageNeutral = (img: ImageItem) =>
  neutralTextForPalette(img.palette?.[0] ?? img.dominantColor ?? dominantColor);

// Radical layout flattens every image into its own fullscreen screen — pairs
// are no longer composed side-by-side. The order in which the photographer
// authored them (including pair-left/pair-right) is preserved.
const screens = images.map((img, index) => ({
  img,
  index,
  exif: formatExif(img.exif, img.metadata),
  neutral: imageNeutral(img),
}));
---
<section class="roll-section">
  <div class="film-counter" id="film-counter" aria-hidden="true">
    <span class="film-num" id="film-current">01</span>
    <span class="film-sep"> — </span>
    <span class="film-total">{screens.length.toString().padStart(2, '0')}</span>
  </div>

  <div
    class="roll-header reveal-on-scroll"
    style={`--poem-l: ${heroPoem.light}; --poem-d: ${heroPoem.dark};`}
  >
    <h2 class="roll-title">{title}</h2>
    {poem && <p class="roll-poem-global">{poem}</p>}
    <div class="roll-line"></div>
  </div>

  <div class="roll-screens" data-roll-palette={JSON.stringify(effectivePalette)}>
    {screens.map(({ img, index, exif, neutral }) => {
      const paletteAttr = JSON.stringify(img.palette || [dominantColor]);
      const hasPoem = Boolean(img.poem);
      const sheetId = `photo-poem-${index}`;
      return (
        <article
          class="photo-screen color-trigger"
          data-palette={paletteAttr}
          data-color={img.dominantColor || dominantColor}
          style={`--poem-l: ${neutral.light}; --poem-d: ${neutral.dark};`}
        >
          <div
            class="photo-frame clickable-image has-overlay"
            role="button"
            tabindex="0"
            aria-label={img.alt || `Ouvrir la photo ${index + 1} en plein écran`}
            data-url={img.url}
            data-exif={exif}
            data-poem={img.poem || ''}
            data-orientation={img.orientation}
          >
            <div class="photo-frame-inner">
              <picture>
                {isProd && (
                  <source
                    type="image/avif"
                    srcset={[800, 1200, 1800, 2400].map(w => vercelImg(img.url, w) + ` ${w}w`).join(', ')}
                    sizes="(max-width: 768px) 100vw, min(90vw, 1600px)"
                  />
                )}
                <img
                  src={vercelImg(img.url, 1600)}
                  alt={img.alt || `Photo ${index + 1} du carnet ${title}`}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding={index === 0 ? "sync" : "async"}
                  fetchpriority={index === 0 ? "high" : undefined}
                  width={img.width}
                  height={img.height}
                  class="styled-image"
                  onerror="this.closest('.photo-frame').classList.add('img-error')"
                />
              </picture>

              {hasPoem && (
                <p class="photo-poem-overlay" aria-hidden="true">{img.poem}</p>
              )}
            </div>
          </div>

          <div class="photo-meta">
            <span class="caption-exif">{exif}</span>
            {hasPoem && (
              <button
                type="button"
                class="photo-reveal-btn"
                aria-expanded="false"
                aria-controls={sheetId}
                aria-label="Révéler le fragment poétique"
              >
                <svg class="icon-eye" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            )}
          </div>

          {hasPoem && (
            <div class="photo-poem-sheet" id={sheetId} hidden>
              <p class="photo-poem-text">{img.poem}</p>
            </div>
          )}
        </article>
      );
    })}
  </div>
</section>

<style>
  .roll-section {
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  .roll-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: clamp(6rem, 14vw, 10rem) 1.5rem clamp(3rem, 8vw, 5rem);
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .roll-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-style: italic;
    font-weight: 500;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .roll-poem-global {
    font-family: var(--font-body);
    font-style: italic;
    color: var(--poem-d, var(--text-poem));
    font-size: clamp(1rem, 2.4vw, 1.2rem);
    line-height: 1.6;
    margin: 0;
    max-width: 560px;
  }

  :root[data-theme="light"] .roll-poem-global {
    color: var(--poem-l, var(--text-poem));
  }

  .roll-line {
    height: 1px;
    width: 100px;
    background-color: color-mix(in srgb, var(--text-muted) 35%, transparent);
  }

  /* ── Fullscreen photo screens ───────────────────────────────────────── */
  .roll-screens {
    display: flex;
    flex-direction: column;
  }

  .photo-screen {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: clamp(2rem, 6vh, 4rem) clamp(1rem, 3vw, 2.5rem);
    box-sizing: border-box;
  }

  .photo-frame {
    position: relative;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    max-width: min(100%, 1500px);
    max-height: 82dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .photo-frame:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  .photo-frame-inner {
    position: relative;
    display: inline-block;
    max-width: 100%;
    max-height: 82dvh;
  }

  /* Skeleton shimmer until the image loads */
  .photo-frame:not(.loaded):not(.img-error) .photo-frame-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--text-muted) 8%, transparent) 0%,
      color-mix(in srgb, var(--text-muted) 18%, transparent) 50%,
      color-mix(in srgb, var(--text-muted) 8%, transparent) 100%
    );
    background-size: 200% 100%;
    animation: roll-shimmer 1.8s infinite ease-in-out;
    z-index: 1;
    pointer-events: none;
  }
  @keyframes roll-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-frame:not(.loaded):not(.img-error) .photo-frame-inner::before { animation: none; }
  }

  .photo-frame.img-error .styled-image { display: none; }
  .photo-frame.img-error .photo-frame-inner::after {
    content: attr(aria-label);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 3 / 2;
    border: 1px solid color-mix(in srgb, var(--text-muted) 30%, transparent);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .styled-image {
    display: block;
    max-width: 100%;
    max-height: 82dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
    /* Film development: gentle blur → sharp on viewport entry */
    filter: blur(3px) brightness(1.04) contrast(0.95) sepia(0.06);
    transition: filter 0.7s ease-out;
  }
  .styled-image.developed {
    filter: blur(0) brightness(1) contrast(1) sepia(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .styled-image { filter: none; transition: none; }
  }

  /* ── Desktop poem overlay (hover) ────────────────────────────────────── */
  .photo-poem-overlay {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    margin: 0;
    max-width: min(38ch, 60%);
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: #ffffff;
    mix-blend-mode: difference;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    pointer-events: none;
    text-wrap: balance;
    white-space: pre-line;
    z-index: 2;
  }

  /* Show overlay on hover/focus — desktop pointer only */
  @media (hover: hover) and (pointer: fine) {
    .photo-frame:hover .photo-poem-overlay,
    .photo-frame:focus-visible .photo-poem-overlay {
      opacity: 0.92;
      transform: translateY(0);
    }

    /* Mobile-only revelation UI hidden on desktop */
    .photo-reveal-btn,
    .photo-poem-sheet {
      display: none;
    }
  }

  /* ── Photo meta line (caption + reveal button) ───────────────────────── */
  .photo-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: min(100%, 1500px);
    margin: 0 auto;
    padding: 0 0.25rem;
    box-sizing: border-box;
  }

  .caption-exif {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--poem-d, var(--text-muted));
    opacity: 0.65;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :root[data-theme="light"] .caption-exif {
    color: var(--poem-l, var(--text-muted));
  }

  /* ── Mobile-only reveal button + slide-up sheet ──────────────────────── */
  @media (hover: none), (pointer: coarse) {
    .photo-poem-overlay { display: none; }
  }

  .photo-reveal-btn {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid color-mix(in srgb, var(--text-muted) 35%, transparent);
    border-radius: 50%;
    color: var(--text-main);
    opacity: 0.7;
    cursor: pointer;
    transition: opacity 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }
  .photo-reveal-btn:hover,
  .photo-reveal-btn:focus-visible {
    opacity: 1;
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
  }
  .photo-reveal-btn[aria-expanded="true"] {
    opacity: 1;
    border-color: var(--accent);
    transform: rotate(180deg);
  }
  .icon-eye { display: block; }

  .photo-poem-sheet {
    width: 100%;
    max-width: min(100%, 1500px);
    margin: 0 auto;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
  }
  .photo-poem-sheet[aria-hidden="false"] {
    max-height: 40rem;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-poem-sheet { transition: none; }
  }

  .photo-poem-text {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1rem, 2.4vw, 1.2rem);
    line-height: 1.6;
    color: var(--poem-d, var(--text-poem));
    margin: 1.25rem 0 0;
    padding: 1rem 1.25rem;
    border-left: 1px solid color-mix(in srgb, var(--text-muted) 35%, transparent);
    white-space: pre-line;
    text-wrap: balance;
  }
  :root[data-theme="light"] .photo-poem-text {
    color: var(--poem-l, var(--text-poem));
  }

  /* ── Film counter (vertical, right edge, desktop only) ───────────────── */
  .film-counter {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    z-index: 100;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .film-counter.is-active { opacity: 1; }
  .film-num {
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    opacity: 0.9;
  }
  .film-sep { color: var(--text-muted); opacity: 0.4; }
  .film-total { color: var(--text-muted); opacity: 0.5; }

  @media (max-width: 1024px) { .film-counter { display: none; } }
</style>

<script>
  import { applyThemeColors } from '../scripts/utils/colors';
  import { REVEAL_THRESHOLD } from '../scripts/utils/scroll';
  import { playViewportTone } from '../scripts/utils/audio';
  import { haptics } from '../scripts/utils/haptics';

  let currentCleanup: (() => void) | null = null;

  function initRoll() {
    const rollContainer = document.querySelector('.roll-screens');
    if (!rollContainer) return;

    window.scrollTo(0, 0);

    const initialPaletteStr = rollContainer.getAttribute('data-roll-palette');
    const initialPalette = initialPaletteStr ? JSON.parse(initialPaletteStr) : [];
    if (initialPalette && initialPalette.length > 0) {
      applyThemeColors(initialPalette, true, true);
    }

    if (currentCleanup) {
      currentCleanup();
      currentCleanup = null;
    }

    // ── Aura swap as each photo enters the viewport ─────────────────────
    const colorTriggers = document.querySelectorAll('.color-trigger');
    const colorObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const paletteStr = (entry.target as HTMLElement).dataset.palette;
        const palette = paletteStr ? JSON.parse(paletteStr) : [];
        if (palette && palette.length > 0) {
          applyThemeColors(palette, true);
        }
      });
    }, { threshold: REVEAL_THRESHOLD });
    colorTriggers.forEach(t => colorObserver.observe(t));

    // ── Lightbox open on photo click / Enter / Space ────────────────────
    const clickableImages = Array.from(document.querySelectorAll('.clickable-image')) as HTMLElement[];
    const allImages = clickableImages.map(el => ({
      url: el.dataset.url || '',
      exif: el.dataset.exif || '',
      poem: el.dataset.poem || '',
      orientation: el.dataset.orientation as 'portrait' | 'landscape' | undefined,
    }));

    const photoListeners = new Map<HTMLElement, { click: () => void; key: (e: KeyboardEvent) => void }>();
    clickableImages.forEach((el, index) => {
      const openLightbox = () => {
        haptics.tap();
        window.dispatchEvent(new CustomEvent('open-lightbox', {
          detail: { images: allImages, index }
        }));
      };
      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox();
        }
      };
      el.addEventListener('click', openLightbox);
      el.addEventListener('keydown', onKey);
      photoListeners.set(el, { click: openLightbox, key: onKey });
    });

    // ── Reveal button (mobile) toggles the slide-up poem sheet ──────────
    const revealBtns = Array.from(document.querySelectorAll('.photo-reveal-btn')) as HTMLButtonElement[];
    const revealListeners = new Map<HTMLButtonElement, () => void>();
    revealBtns.forEach(btn => {
      const onClick = () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const next = !expanded;
        btn.setAttribute('aria-expanded', String(next));
        const sheetId = btn.getAttribute('aria-controls');
        if (!sheetId) return;
        const sheet = document.getElementById(sheetId);
        if (!sheet) return;
        if (next) {
          sheet.removeAttribute('hidden');
          sheet.setAttribute('aria-hidden', 'false');
        } else {
          sheet.setAttribute('aria-hidden', 'true');
          window.setTimeout(() => {
            if (btn.getAttribute('aria-expanded') === 'false') {
              sheet.setAttribute('hidden', '');
            }
          }, 500);
        }
        haptics.tap();
      };
      btn.addEventListener('click', onClick);
      revealListeners.set(btn, onClick);
    });

    // ── One subtle tone per image on first viewport entry ───────────────
    const total = clickableImages.length;
    const toneObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const idx = clickableImages.indexOf(entry.target as HTMLElement);
        playViewportTone(idx, total);
        toneObserver.unobserve(entry.target);
      });
    }, { threshold: 0.6 });
    clickableImages.forEach(img => toneObserver.observe(img));

    // ── Photo development (filter blur → sharp) + skeleton toggle ───────
    const styledImages = Array.from(document.querySelectorAll('.styled-image')) as HTMLImageElement[];
    const markLoaded = (img: HTMLImageElement) => {
      const frame = img.closest('.photo-frame');
      frame?.classList.add('loaded');
    };
    styledImages.forEach(img => {
      if (img.complete && img.naturalWidth > 0) markLoaded(img);
      else img.addEventListener('load', () => markLoaded(img), { once: true });
    });

    const developObs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const img = entry.target as HTMLImageElement;
        const reveal = () => window.setTimeout(() => img.classList.add('developed'), 120);
        if (img.complete) reveal();
        else img.addEventListener('load', reveal, { once: true });
        developObs.unobserve(img);
      });
    }, { threshold: 0.05 });
    styledImages.forEach(img => {
      const inInitialViewport = img.getBoundingClientRect().top < window.innerHeight;
      if (inInitialViewport && img.complete && img.naturalWidth > 0) {
        img.classList.add('developed');
        return;
      }
      developObs.observe(img);
    });

    // ── Film counter (one frame per .photo-screen) ──────────────────────
    const filmCounter = document.getElementById('film-counter');
    const filmCurrent = document.getElementById('film-current');
    const rollSectionEl = document.querySelector('.roll-section');
    const frames = Array.from(document.querySelectorAll('.photo-screen'));

    let sectionObs: IntersectionObserver | null = null;
    let frameObs: IntersectionObserver | null = null;
    if (filmCounter && filmCurrent && rollSectionEl && frames.length > 0) {
      sectionObs = new IntersectionObserver((entries) => {
        entries.forEach(e => filmCounter.classList.toggle('is-active', e.isIntersecting));
      }, { threshold: 0.01 });
      sectionObs.observe(rollSectionEl);

      frameObs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const idx = frames.indexOf(entry.target) + 1;
            filmCurrent.textContent = idx.toString().padStart(2, '0');
          }
        });
      }, { threshold: 0.5 });
      frames.forEach(f => frameObs!.observe(f));
    }

    currentCleanup = () => {
      colorObserver.disconnect();
      developObs.disconnect();
      toneObserver.disconnect();
      sectionObs?.disconnect();
      frameObs?.disconnect();
      photoListeners.forEach((fns, el) => {
        el.removeEventListener('click', fns.click);
        el.removeEventListener('keydown', fns.key);
      });
      revealListeners.forEach((fn, btn) => btn.removeEventListener('click', fn));
    };
  }

  document.addEventListener('astro:page-load', initRoll);
</script>

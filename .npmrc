# @vite-pwa/astro 1.2.0 (latest) still declares astro <=5 as its peer range while
# this project runs astro 6.x. The integration works, but npm install/ci refuse the
# tree without this flag. Keep it until @vite-pwa/astro publishes astro 6 support,
# so local installs and the Vercel build resolve identically.
legacy-peer-deps=true
